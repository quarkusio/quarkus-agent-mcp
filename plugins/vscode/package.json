{
  "name": "quarkus-agent",
  "displayName": "Quarkus Agent MCP",
  "description": "Registers the Quarkus Agent MCP server with VS Code agent mode, so AI agents can create, run and develop Quarkus applications.",
  "version": "0.1.0",
  "publisher": "quarkusio",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "homepage": "https://github.com/quarkusio/quarkus-agent-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/quarkusio/quarkus-agent-mcp.git",
    "directory": "plugins/vscode"
  },
  "bugs": "https://github.com/quarkusio/quarkus-agent-mcp/issues",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "keywords": [
    "quarkus",
    "java",
    "mcp",
    "agent"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "quarkus-agent",
        "label": "Quarkus Agent"
      }
    ],
    "commands": [
      {
        "command": "quarkusAgent.checkForUpdates",
        "title": "Check for Updates",
        "category": "Quarkus Agent"
      },
      {
        "command": "quarkusAgent.showServerLog",
        "title": "Show Server Log",
        "category": "Quarkus Agent"
      }
    ],
    "configuration": {
      "title": "Quarkus Agent",
      "properties": {
        "quarkusAgent.launchMode": {
          "type": "string",
          "enum": [
            "auto",
            "native",
            "jar",
            "jbang"
          ],
          "enumDescriptions": [
            "Use the native binary where one is published for this platform, otherwise the uber-jar with Java 21+, otherwise JBang.",
            "Download and run the native binary (Linux x86_64 and macOS only).",
            "Download the uber-jar and run it with Java 21+.",
            "Run the quarkus-agent-mcp@quarkusio JBang alias."
          ],
          "default": "auto",
          "description": "How to launch the Quarkus Agent MCP server."
        },
        "quarkusAgent.version": {
          "type": "string",
          "default": "latest",
          "pattern": "^(latest|\\d+\\.\\d+\\.\\d+.*)$",
          "description": "Server release to use, e.g. 1.2.9, or 'latest'. Ignored in jbang mode, which always resolves the latest release."
        },
        "quarkusAgent.javaHome": {
          "type": "string",
          "default": "",
          "description": "JDK (21+) used to run the uber-jar. When empty, java.jdt.ls.java.home, JAVA_HOME and the PATH are tried in that order."
        },
        "quarkusAgent.env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Extra environment variables for the server, e.g. AGENT_MCP_SKILLS_INCLUDE_TRANSITIVE."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "vscode:prepublish": "npm run compile",
    "package": "cp ../../LICENSE LICENSE && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "~1.101.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.9.2"
  }
}
